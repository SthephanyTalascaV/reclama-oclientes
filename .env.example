# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.
# Variáveis VITE_* vão para o navegador (são públicas por natureza no Firebase).
# As demais ficam SÓ no servidor — nunca prefixe um segredo com VITE_.

# ---------- Modo demonstração ----------
# true = dados fictícios em memória, sem login, sem HubSpot/IA reais. NUNCA use em produção.
DEMO_MODE=false
VITE_DEMO_MODE=false

# ---------- Firebase: navegador (Configurações do projeto > Seus apps > Web) ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_APP_ID=

# ---------- Firebase: servidor (Contas de serviço > Gerar nova chave privada) ----------
# JSON da conta de serviço em base64:  base64 -w0 service-account.json   (PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json")))
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Alternativa ao base64:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app

# ---------- IA (Google Gemini) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---------- HubSpot (app privado / chave de serviço, somente leitura) ----------
# Escopos: crm.objects.contacts.read, crm.objects.companies.read
HUBSPOT_ACCESS_TOKEN=
# ID do portal — usado só para montar o link do contato (ex.: 1554114)
HUBSPOT_PORTAL_ID=
# "v3" (padrão) ou uma versão por data, ex.: 2026-09
HUBSPOT_API_VERSION=v3

# ---------- Acesso ----------
ALLOWED_EMAIL_DOMAIN=nibo.com.br
# e-mails extras liberados fora do domínio (separados por vírgula)
ALLOWED_EMAILS=
# quem pode editar categorias/produtos e excluir registros. Vazio = todos os usuários permitidos.
ADMIN_EMAILS=

# ---------- Segurança ----------
# Segredo longo e aleatório (assina a análise da IA entre a leitura e o salvamento):  openssl rand -base64 48
APP_SECRET=
# Protege a rota de retenção chamada pelo Vercel Cron
CRON_SECRET=
# Dias que os prints ficam guardados antes de serem apagados (o texto extraído permanece)
IMAGE_RETENTION_DAYS=90
