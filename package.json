{
  "name": "nibo-reclamacoes",
  "private": true,
  "version": "1.0.0",
  "description": "Inteligência de Reclamações de Clientes — ferramenta interna do CS Nibo",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"node --env-file-if-exists=.env.local server/dev-server.js\" \"vite\"",
    "dev:demo": "concurrently -n api,web -c blue,magenta \"DEMO_MODE=true node server/dev-server.js\" \"vite\"",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
